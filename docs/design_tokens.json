{
  "name": "forecast-app",
  "version": "1.0.0",
  "note": "System colours from Apple's Human Interface Guidelines (grouped backgrounds, label colours, separators, system tints). Where a standard tint is under 4.5:1 as text, the HIG increased-contrast variant is used, so every text colour passes WCAG 2.2 AA on bg, surface1 and surface2. Text on the red 'down' colour uses onDown. These are the defaults and the 'Apple' preset; the previous navy look is the 'Midnight' preset in Site Studio. The live values come from Site Studio (doc 16). Do not change a value without re-running the contrast check.",
  "color": {
    "dark": {
      "bg": "#000000",
      "surface1": "#1C1C1E",
      "surface2": "#2C2C2E",
      "surface3": "#3A3A3C",
      "border": "#38383A",
      "borderStrong": "#545458",
      "text": "#FFFFFF",
      "text2": "#EBEBF5",
      "text3": "#98989F",
      "brand": "#409CFF",
      "onBrand": "#000000",
      "tierStrong": "#30D158",
      "tierSolid": "#64D2FF",
      "tierWatch": "#FF9F0A",
      "up": "#30D158",
      "down": "#FF6961",
      "onDown": "#000000",
      "chart1": "#409CFF",
      "chart2": "#30D158",
      "chart3": "#FF9F0A",
      "chart4": "#FF375F",
      "chart5": "#5E5CE6",
      "chart6": "#BF5AF2",
      "cardYellow": "#FFD60A",
      "cardRed": "#FF453A"
    },
    "light": {
      "bg": "#F2F2F7",
      "surface1": "#FFFFFF",
      "surface2": "#F2F2F7",
      "surface3": "#E5E5EA",
      "border": "#E5E5EA",
      "borderStrong": "#C7C7CC",
      "text": "#000000",
      "text2": "#3C3C43",
      "text3": "#6C6C70",
      "brand": "#0066CC",
      "onBrand": "#FFFFFF",
      "tierStrong": "#1D7A32",
      "tierSolid": "#0071A4",
      "tierWatch": "#B25000",
      "up": "#1D7A32",
      "down": "#D70015",
      "onDown": "#FFFFFF",
      "chart1": "#0066CC",
      "chart2": "#1D7A32",
      "chart3": "#B25000",
      "chart4": "#D30F45",
      "chart5": "#5856D6",
      "chart6": "#8944AB",
      "cardYellow": "#FFCC00",
      "cardRed": "#FF3B30"
    }
  },
  "font": {
    "family": "-apple-system, BlinkMacSystemFont, system-ui, 'Segoe UI', Roboto, sans-serif",
    "features": "'tnum' 1",
    "scale_px": {
      "xs": 12,
      "sm": 14,
      "base": 16,
      "lg": 18,
      "xl": 22,
      "2xl": 28,
      "3xl": 34
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "lineHeight": {
      "tight": 1.2,
      "normal": 1.5
    },
    "hig_text_styles_px": {
      "largeTitle": 34,
      "title1": 28,
      "title2": 22,
      "title3": 20,
      "headline": 17,
      "body": 17,
      "callout": 16,
      "subheadline": 15,
      "footnote": 13,
      "caption1": 12,
      "caption2": 11
    }
  },
  "space_px": [
    0,
    4,
    8,
    12,
    16,
    20,
    24,
    32,
    40,
    48,
    64
  ],
  "radius_px": {
    "sm": 8,
    "md": 12,
    "lg": 16,
    "pill": 999
  },
  "elevation": {
    "dark": {
      "card": "none"
    },
    "light": {
      "card": "none"
    },
    "note": "Content over chrome: grouped surfaces separated by background colour and hairline separators, not shadows. Floating layers (sheets, popovers, menus) use the material blur in hig.css."
  },
  "motion_ms": {
    "fast": 150,
    "base": 220,
    "slow": 600
  },
  "easing": "cubic-bezier(0.32, 0.72, 0, 1)",
  "breakpoints_px": {
    "sm": 640,
    "md": 768,
    "lg": 1024,
    "xl": 1280
  },
  "layout": {
    "maxWidth_px": 1200,
    "gutter_px": {
      "mobile": 16,
      "desktop": 24
    },
    "bottomTabHeight_px": 64,
    "headerHeight_px": 56
  },
  "tier": {
    "Strong": {
      "label": "Strong",
      "dots": 3,
      "colorToken": "tierStrong"
    },
    "Solid": {
      "label": "Solid",
      "dots": 2,
      "colorToken": "tierSolid"
    },
    "Watch": {
      "label": "Watch",
      "dots": 1,
      "colorToken": "tierWatch"
    }
  },
  "contrast_checks_to_run": [
    [
      "text",
      "bg"
    ],
    [
      "text2",
      "surface1"
    ],
    [
      "text3",
      "surface1"
    ],
    [
      "brand",
      "bg"
    ],
    [
      "onBrand",
      "brand"
    ],
    [
      "tierStrong",
      "surface1"
    ],
    [
      "tierSolid",
      "surface1"
    ],
    [
      "tierWatch",
      "surface1"
    ],
    [
      "up",
      "surface1"
    ],
    [
      "down",
      "surface1"
    ]
  ]
}
